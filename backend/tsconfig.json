{
  // ts-node only type-checks files reachable from the entrypoint, so ambient
  // stubs (src/types/node-sqlite.d.ts) never load without `files` — without
  // it `node:sqlite` fails to resolve under nodemon. tsc -b is unaffected.
  "ts-node": { "files": true },
  "compilerOptions": {
    "experimentalDecorators": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "es2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "lib": ["es2020"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}

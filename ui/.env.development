# Dev-only: the Vite dev server serves the UI on :3000, but the backend runs
# on :3001. Without this, SOCKET_URL falls back to window.location.origin
# (:3000) and the socket client can't reach the server. Production builds
# don't load this file, so they connect to the page's own origin.
VITE_SOCKET_URL=http://localhost:3001

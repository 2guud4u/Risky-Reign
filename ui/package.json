{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "scripts": {
    "prestart": "npm --prefix .. run build:common",
    "start": "vite",
    "build": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\" --max-warnings 0 && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "pretty": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-checker": "^0.14.5"
  }
}
